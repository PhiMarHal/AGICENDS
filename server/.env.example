# AGICENDS game server — LOCAL ENVIRONMENT (secrets).
# Do NOT commit this file. It is gitignored (see .gitignore).
#
# Load it when launching the server:
#   node --env-file=.env server.js        (use Node 24+)
# or, if you wired npm:
#   npm start                             (after updating the start script)

# Base URL of the Cloudflare Worker that issues + verifies session tokens.
# Must be the SAME Worker that issued your login token (your deployed one),
# otherwise /auth/verify will reject it and you'll join as anon again.
AUTH_WORKER_URL=https://agiscends-auth.philoiyaa.workers.dev

# Shared secret for posting match results to the Worker's /stats/record.
# Must equal the value you set on the Worker with:
#   wrangler secret put GAME_SERVER_SHARED_SECRET
# NOTE: only needed for stat recording — login + custom skins work without it.
# Replace the placeholder below with your real secret.
GAME_SERVER_SHARED_SECRET=REPLACE_WITH_YOUR_REAL_SHARED_SECRET